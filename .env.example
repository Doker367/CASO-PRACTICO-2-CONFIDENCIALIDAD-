# ===== Base de datos =====
POSTGRES_USER=rbac_user
POSTGRES_PASSWORD=RbacStrongPass2026
POSTGRES_DB=rbac_app
DATABASE_URL=postgresql://rbac_user:RbacStrongPass2026@postgres:5432/rbac_app?schema=public

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== JWT (generar con: openssl rand -base64 64) =====
JWT_SECRET=CHANGE_ME_USE_openssl_rand_base64_64_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_USE_openssl_rand_base64_64_BYTES_OTHER
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ===== Cookies / CORS =====
COOKIE_SECURE=true
CORS_ORIGIN=https://localhost:8443,https://localhost
APP_PORT=3000

# ===== Mail (MailHog en dev) =====
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@unach.local
APP_BASE_URL=https://localhost:8443

# ===== Seguridad =====
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60
